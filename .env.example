# Copy to .env and fill in the keys you use. Never commit .env.
# ./run.sh sources this file automatically.

# Default provider is SiliconFlow (tencent/Hy3). Set one of:
SILICONFLOW_KEY=
# SILICONFLOW_API_KEY=   # alias also accepted
# SILICONFLOW_API=       # alias also accepted

# Optional other providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
GENERALCOMPUTE_API_KEY=

# Optional: override Chrome binary (BrowserOS or Chrome for Testing)
# CHROME_PATH=/absolute/path/to/chrome
# CALLISTO_CHROME_PATH=/absolute/path/to/chrome

# Optional: Ollama base URL when using --ollama
# OLLAMA_HOST=http://127.0.0.1:11434
