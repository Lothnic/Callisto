{
  "version": 1,
  "steps": [
    "navigate",
    "click",
    "fill",
    "submit",
    "select",
    "check",
    "hover",
    "press",
    "scroll",
    "wait",
    "wait_for",
    "extract",
    "drag"
  ],
  "tools": [
    {
      "name": "callisto_press",
      "description": "Dispatch synthetic keydown/keyup on the focused control, including chords such as Control+A. For JavaScript keyboard handlers only: native editing, focus navigation, shortcuts and form submission defaults are not emulated. Use fill or submit for those operations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_frames",
      "description": "List frames in the controlled tab. Frame access depends on granted website permissions.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_frame",
      "description": "Select a frame by frame_id from callisto_frames, inject the bridge and return a fresh snapshot. Navigation resets selection. Cross-origin frame input fails closed because parent hit testing cannot be verified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "frame_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_handoff",
      "description": "Ask the user to complete a step in the shared page, then click Continue with agent. Use message; prompt is supported for compatibility. Confirmation is not proof of task success.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          }
        },
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "prompt"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_capabilities",
      "description": "Report backend capabilities without reading page content.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_upload",
      "description": "Set files on a visible file input in the controlled page. Reads explicit local file paths, at most 10 files and 10 MiB total. Page input/change handlers may upload immediately. Does not submit the form.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ref",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_pair",
      "description": "Get the persistent local browser pairing code (only needed for initial setup) for the Firefox/Zen tab bridge. Enter it in the extension, then explicitly share the desired existing tab.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_status",
      "description": "Check connection, selected tab and execution state without reading page content. fullAccess=true means Full browser control is enabled in the extension; page tools can adopt and activate tabs automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_browser",
      "description": "Manage the user's browser after they grant Enable browser access in the extension. background start/pause/resume/stop controls only the already shared tab and needs the optional tabs grant; the user must prepare the window in the extension first because Firefox/Zen may focus it on creation. Execution then preserves the tab and login in an unfocused agent window. View is a user control. Other actions support tabs, screenshots, cookies, bookmarks, history and downloads. tab_select activates and shares that existing tab; tab_activate only focuses it, including browser-protected pages. tab_create accepts an HTTP(S) url and window_id; omitting url creates about:blank. Use tab_navigate with tab_id and an HTTP(S) url to load a blank tab before page actions. In opt-in Full browser control mode, new tabs/windows are automatically shared and page tools can adopt the active tab or reactivate their selected tab. Full mode can only be enabled in the extension UI; Stop turns it off. Check callisto_status.fullAccess. Browser restrictions still apply. window_close closes the specified whole window, including its tabs; use the id returned by window_create for agent-window cleanup. Cookie values are sensitive. Downloads prompt for a save location. Zen may omit inactive workspaces. tab_name associates a handle with tab_id; tab_resolve returns it; tab_select/tab_activate/tab_close accept tab_name instead of tab_id. Handles survive extension reloads while the tab remains available and are removed when the tab closes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "background",
              "tabs_list",
              "windows_list",
              "tab_select",
              "tab_activate",
              "tab_create",
              "tab_navigate",
              "window_create",
              "window_close",
              "agent_container",
              "tab_close",
              "back",
              "forward",
              "reload",
              "screenshot",
              "cookies_list",
              "cookie_set",
              "cookie_remove",
              "bookmarks_search",
              "history_search",
              "downloads_search",
              "download",
              "tab_name",
              "tab_resolve"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "resume",
              "stop"
            ],
            "description": "Required for background. The agent window must remain unfocused and unminimized; unsupported conditions pause instead of raising it."
          },
          "window_id": {
            "type": "integer",
            "minimum": 0
          },
          "tab_id": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "agent_container": {
            "type": "boolean",
            "description": "Create a new tab or window in the opt-in isolated Callisto cookie container; existing logins will not be available there."
          },
          "cookie_store_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "tab_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_page",
      "description": "Additional DOM operations on the active controlled page. scroll uses viewport pixel deltas; hover dispatches synthetic pointer/mouse events; select chooses an option by value; check sets a checkbox; text returns bounded visible body text; find searches visible body text. Input uses the explicitly selected callisto_input mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "scroll",
              "hover",
              "select",
              "check",
              "text",
              "find"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$"
          },
          "value": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "delta_x": {
            "type": "number"
          },
          "delta_y": {
            "type": "number"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_scroll",
      "description": "Scroll by viewport pixel deltas. Returns compact page feedback.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "delta_x": {
            "type": "number",
            "default": 0
          },
          "delta_y": {
            "type": "number"
          }
        },
        "required": [
          "delta_y"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_screenshot",
      "description": "Capture the controlled tab. Viewport PNG/JPEG works through the extension; full_page and clip require lease-bound BiDi. No focus changes are made.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ],
            "default": "jpeg"
          },
          "full_page": {
            "type": "boolean"
          },
          "clip": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 10000
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_find",
      "description": "Search visible page text and return bounded matching snippets. Unlike Chromium accessibility search, this uses rendered DOM text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "max_matches": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_submit",
      "description": "Submit the form associated with a snapshot ref, preserving browser validation and submit handlers. Use an input or submit-button ref. Submission may navigate; the next snapshot waits for the page. Target by ref or exact role and name. Uses the selected input mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [],
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_batch",
      "description": "Execute 1\u201310 dependent steps using the same contracts as standalone tools, then return a snapshot. All steps are validated before dispatch. Ten-second budget; earlier actions are not rolled back.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {}
          }
        },
        "required": [
          "actions"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_extract",
      "description": "Read structured rows from the shared page using CSS selectors: a row selector plus a field map. Optionally follow a next-page control and merge pages. Returns typed rows, not a snapshot, so counting and aggregation need one call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 20,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string"
                    },
                    "attribute": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "number"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "include_text": {
            "type": "boolean"
          },
          "paginate": {
            "type": "object",
            "properties": {
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "max_pages": {
                "type": "integer",
                "minimum": 1,
                "maximum": 25
              }
            },
            "required": [
              "next"
            ]
          }
        },
        "required": [
          "selector",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_run",
      "description": "Execute 1\u201340 steps using the same actions and fields as standalone tools. All steps are validated before dispatch. Returns compact final page feedback, the last extraction and an optional snapshot. Stops on failure; earlier actions are not rolled back. Never replay uncertain writes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {}
          },
          "snapshot": {
            "type": "boolean"
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_input",
      "description": "Enable trusted BiDi input under the extension shared-tab lease. Explicit loopback endpoint required. Stop sharing revokes new input, network and observations together. No synthetic fallback. Existing callisto_run/batch tools use this mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "enable",
              "disable",
              "status"
            ]
          },
          "endpoint": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_network",
      "description": "Inspect traffic in the explicitly shared tab with optional network permission. Start with 1-10 exact origins; list bounded redacted metadata; endpoints summarizes observed paths and field names; optional JSON/form bodies; rules block or redirect within scope. Stop removes rules. Export HAR to a new absolute output_path or return JSON. Capture never supplies credentials or bypasses site authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "list",
              "endpoints",
              "compare",
              "schema",
              "openapi",
              "replay",
              "rules",
              "stop",
              "export"
            ]
          },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "capture_bodies": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "include_bodies": {
            "type": "boolean"
          },
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD"
            ]
          },
          "rules": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "block",
                    "redirect"
                  ]
                },
                "url_prefix": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "redirect_url": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "url_prefix"
              ]
            }
          },
          "output_path": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_trace",
      "description": "Record private per-client action JSONL and optional DOM snapshots/screenshots. Start requires a new absolute directory. Checkpoint captures enabled evidence; stop writes a manifest and HAR if a network capture exists. This is not a Playwright trace; screenshots and snapshots can expose private page content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "status",
              "checkpoint",
              "stop"
            ]
          },
          "directory": {
            "type": "string"
          },
          "screenshots": {
            "type": "boolean",
            "default": false
          },
          "snapshots": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_snapshot",
      "description": "Inspect the selected tab. In Full browser control mode, the active tab is adopted automatically when none is selected; otherwise share a tab or call callisto_browser tab_select first. Use max_chars to bound output and offset=next_offset to page through truncated controls. Refs belong to the latest snapshot. This experimental DOM-derived snapshot can omit content and frames. Use focus=auto/main/modal to prioritize a region while retaining navigation. Scoped diff baselines are independent. offset is a line index; use next_offset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 30000
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "include_text": {
            "type": "boolean",
            "default": true
          },
          "diff": {
            "type": "boolean",
            "default": false
          },
          "revision": {
            "type": "string"
          },
          "focus": {
            "type": "string",
            "enum": [
              "all",
              "main",
              "modal",
              "auto"
            ],
            "default": "all"
          },
          "retain_navigation": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_navigate",
      "description": "Navigate the controlled tab to an HTTP(S) URL. Requires website permission. Returns navigation progress; use wait_for for a bounded condition or snapshot to observe the next document.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_click",
      "description": "Click a ref from the latest snapshot in the shared tab using a synthetic DOM click. Some websites reject synthetic input. Target by ref or exact role and name. Uses the selected input mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [],
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_fill",
      "description": "Fill a ref from the latest snapshot in the shared tab using synthetic input events. Some websites reject synthetic input. Target by ref or exact role and name. Uses the selected input mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "value": {
            "type": "string",
            "maxLength": 100000
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "value"
        ],
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_close",
      "description": "Stop sharing the tab without closing it or the browser.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "callisto_select",
      "description": "Select an enabled option by its value or unique displayed label.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "value": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ]
      }
    },
    {
      "name": "callisto_check",
      "description": "Set a checkbox to the requested state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "checked": {
            "type": "boolean"
          }
        },
        "required": [
          "checked"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ]
      }
    },
    {
      "name": "callisto_hover",
      "description": "Move over a target using the selected input mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ax-[0-9]+$",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "ref"
            ]
          },
          {
            "required": [
              "role",
              "name"
            ]
          }
        ]
      }
    },
    {
      "name": "callisto_wait_for",
      "description": "Wait within the runtime for text or a CSS selector state; avoids repeated agent polling. Read-only waits may continue across navigation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "selector": {
            "type": "string",
            "minLength": 1,
