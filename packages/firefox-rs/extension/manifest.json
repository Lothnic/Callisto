{
  "manifest_version": 2,
  "name": "Callisto Tab Bridge (Experimental)",
  "version": "0.3.1",
  "description": "Share the current Firefox or Zen tab with a local Callisto session.",
  "browser_specific_settings": {
    "gecko": {
      "id": "callisto-tab-bridge@lothnic.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity",
          "websiteActivity",
          "bookmarksInfo",
          "authenticationInfo",
          "searchTerms"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "menus",
    "storage",
    "webNavigation",
    "contextualIdentities"
  ],
  "optional_permissions": [
    "<all_urls>",
    "tabs",
    "tabHide",
    "cookies",
    "bookmarks",
    "history",
    "downloads",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "browser-control.js",
      "api-analysis.js",
      "network.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Callisto \u2014 share this tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "64": "icon-64.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false,
    "browser_style": false
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  }
}
