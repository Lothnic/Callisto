{
  "manifest_version": 2,
  "name": "Callisto Tab Bridge (Experimental)",
  "version": "0.1.0",
  "description": "Share the current Firefox or Zen tab with a local Callisto session.",
  "browser_specific_settings": {
    "gecko": {
      "id": "callisto-tab-bridge@lothnic.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity", "websiteActivity", "bookmarksInfo", "authenticationInfo", "searchTerms"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "menus",
    "storage",
    "webNavigation",
    "contextualIdentities"
  ],
  "optional_permissions": [
    "<all_urls>",
    "tabs",
    "cookies",
    "bookmarks",
    "history",
    "downloads"
  ],
  "background": {
    "scripts": [
      "browser-control.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Callisto \u2014 share this tab",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false,
    "browser_style": false
  }
}
