{
  "manifest_version": 2,
  "name": "Callisto Tab Bridge (Experimental)",
  "version": "0.1.0",
  "description": "Share the current Firefox or Zen tab with a local Callisto session.",
  "browser_specific_settings": {"gecko": {"id": "callisto-tab-bridge@lothnic.dev", "strict_min_version": "109.0"}},
  "permissions": ["activeTab"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Callisto — share this tab", "default_popup": "popup.html"}
}
