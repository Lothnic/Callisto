{
  "name": "@callisto/mini",
  "version": "0.1.0",
  "description": "Token-lean CDP wrapper over Chromium for browser agents.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src/sidecar.ts"],
  "bin": {
    "callisto-sidecar": "./src/sidecar.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "sidecar": "tsx src/sidecar.ts"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "chrome-remote-interface": "^0.33.3"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
